package chapter3_4;

import java.util.ArrayList;

public class Exercise_99 {

	public static void main(String[] args) {
		var list = new ArrayList< ArrayList<Integer>>();
//		System.out.println(list);
		for(int i=1;i<10;i++) {
			list.add(new ArrayList<Integer>());
//			System.out.println(list);
			for(int j=1;j<10;j++) {
					list.get(i-1).add(i*j);
			}
		}
		
		System.out.println(list);
		

	}

}
