public class Util {
// static は new が要らない。
//　宣言と同時にメモリが確保され配置される。
//	だからわざわざメモリ確保の予約語である newを
//	書かなくてよい。結果として？クラスメソッドとして、
//	インスタンスを生成せずとも使える。
	
	/**
	 * 
	 * @param hankei
	 * @return
	 */
	public static double menseki(double hankei) {
		double s = Math.pow(hankei, 2)*Math.PI;
		return s;
	}
}
